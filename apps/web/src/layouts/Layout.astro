---
// Layout.astro - 全局布局组件
// 提供完整的 HTML 骨架、全局样式导入和 SEO 基础标签

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
}

const {
  title = "SSST - 图片标注工具",
  description = "基于 Web 的图片标注工具，支持 LabelMe 格式，支持点标注、类别管理、网格裁剪导出",
  ogImage = "/icons/icon-512x512.png",
  ogType = "website",
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteName = "SSST";
const twitterHandle = "@ssst_app";

// JSON-LD 结构化数据
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: title,
  description: description,
  applicationCategory: "GraphicsApplication",
  operatingSystem: "Any",
  url: canonicalUrl,
  image: ogImage,
  author: {
    "@type": "Organization",
    name: siteName,
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />

    <!-- 基础 SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content={twitterHandle} />

    <!-- JSON-LD 结构化数据 -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- 图标与 PWA -->
    <link rel="icon" type="image/svg+xml" href="/src/assets/logo.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Service Worker 注册（仅生产环境） -->
    {import.meta.env.PROD && <script is:inline src="/registerSW.js"></script>}
  </head>

  <body>
    <noscript>
      <div style="padding: 2rem; text-align: center; font-family: system-ui, sans-serif;">
        <h1>需要启用 JavaScript</h1>
        <p>本应用需要 JavaScript 才能正常运行，请在浏览器设置中启用 JavaScript。</p>
      </div>
    </noscript>
    <slot />
  </body>
</html>

<style>
  @import "../styles/global.css";
</style>
