---
import Layout from "../layouts/Layout.astro";
import ImageLabeler from "../islands/image-labeler/ImageLabeler";
---

<Layout
  title="SSST - 图片标注工具"
  description="基于 Web 的图片标注工具，支持 LabelMe 格式。提供点标注、类别管理、网格裁剪导出等功能。"
>
  <div class="flex h-screen bg-base-200 text-base-content">
    <!-- Sidebar -->
    <aside class="w-16 bg-base-100 border-r border-base-300 flex flex-col items-center py-4 gap-2 shrink-0">
      <div class="text-xl font-bold mb-4">🧰</div>
      <button
        class="p-2 rounded-lg transition-colors bg-primary text-primary-content"
        title="图片标注"
      >
        <span class="text-xl">🔖</span>
      </button>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 min-w-0 overflow-hidden">
      <ImageLabeler client:only="solid-js" />
    </main>
  </div>
</Layout>
