---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="文档中心 - SSST"
  description="SSST 使用指南与帮助文档。了解如何使用图片标注工具、类别管理、网格裁剪等功能。"
>

  <main class="min-h-screen bg-base-100">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <!-- 返回首页 -->
      <nav class="mb-8">
        <a href="/" class="btn btn-ghost btn-sm gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          返回首页
        </a>
      </nav>

      <!-- 页面标题 -->
      <header class="mb-12">
        <h1 class="text-4xl font-bold mb-4">文档中心</h1>
        <p class="text-lg text-base-content/70">
          SSST 使用指南与帮助文档
        </p>
      </header>

      <!-- 占位内容 -->
      <div class="space-y-8">
        <section class="card bg-base-200">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-4">快速开始</h2>
            <p class="text-base-content/70">
              文档内容即将上线，敬请期待...
            </p>
          </div>
        </section>

        <section class="card bg-base-200">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-4">功能指南</h2>
            <p class="text-base-content/70">
              详细的模块使用说明正在编写中...
            </p>
          </div>
        </section>

        <section class="card bg-base-200">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-4">常见问题</h2>
            <p class="text-base-content/70">
              FAQ 内容即将更新...
            </p>
          </div>
        </section>
      </div>

      <!-- 底部提示 -->
      <footer class="mt-16 pt-8 border-t border-base-300 text-center text-base-content/50">
        <p>文档持续完善中，如有问题请联系开发者</p>
      </footer>
    </div>
  </main>
</Layout>
